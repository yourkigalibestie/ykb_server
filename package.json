{
    "name": "you-kigali-bestie-backend",
    "version": "1.0.0",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "seed:admin": "ts-node-dev --transpile-only src/scripts/seedAdmin.ts",
        "check:admin": "ts-node-dev --transpile-only src/scripts/checkAdmin.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^6.15.0",
        "bcryptjs": "^3.0.2",
        "cloudinary": "^2.7.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "helmet": "^7.2.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "uuid": "^14.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.18",
        "@types/express": "^4.17.23",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.13",
        "@types/node": "^22.17.2",
        "prisma": "^6.15.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.2"
    },
    "prisma": {
        "seed": "npm run seed:admin"
    }
