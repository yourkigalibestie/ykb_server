# Server Environment
NODE_ENV=production
PORT=10000

# Database (PostgreSQL / Supabase / Neon / Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# DIRECT_URL is optional, recommended when using Supabase connection pooling (port 6543 / pgbouncer)
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-token-min-16-chars"
JWT_EXPIRES_IN="7d"

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Platform Fees
PLATFORM_FEE_BPS=0

# CORS / Allowed Origins (comma-separated or * for all)
# Example: https://kigalibespoke.com,https://www.kigalibespoke.com,http://localhost:5173
CORS_ORIGIN="*"
ALLOWED_ORIGINS="http://localhost:5173,https://kigalibespoke.com"

# Pesapal Payment Gateway
PESAPAY_CONSUMER_KEY="your_pesapal_consumer_key"
PESAPAY_CONSUMER_SECRET="your_pesapal_consumer_secret"
PESAPAY_BASE_URL="https://pay.pesapal.com/v3"
PESAPAY_IPN_ID="your_ipn_id"
PESAPAY_CALLBACK_URL="https://your-frontend-url.com/payment/callback"
